# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://postgres:rhosam@localhost:5432/rhosam_hotel

# JWT Secret (change in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Payment Gateway (INTERNAL, PAYSTACK, or FLUTTERWAVE)
PAYMENT_GATEWAY=INTERNAL

# Paystack Configuration (get from dashboard.paystack.com)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Flutterwave Configuration (get from dashboard.flutterwave.com)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# Webhook Secret (for payment verification)
PAYMENT_WEBHOOK_SECRET=

# Frontend URL (for payment redirects)
FRONTEND_URL=http://localhost:5173
